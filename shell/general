

# Databases
alias dock="docker compose --file ~/code/2-areas/databases/docker-compose.yml up"
alias pg18='docker compose --file ~/code/2-areas/databases/docker-compose.yml up postgres18'
alias redis='docker compose --file ~/code/2-areas/databases/docker-compose.yml up redis'
alias meili='docker compose --file ~/code/2-areas/databases/docker-compose.yml up meilisearch meilisearch-test'


alias switch='heroku accounts:set'

# Allow URI schemes to be pasted without need for escaping
# See https://github.com/zsh-users/zsh/blob/master/Functions/Zle/url-quote-magic
autoload -Uz bracketed-paste-magic
zle -N bracketed-paste bracketed-paste-magic
autoload -Uz url-quote-magic
zle -N self-insert url-quote-magic

# Applications
function x {
  if [ -z "$1" ]
  then
    code --new-window .
  else
    code --new-window $1
  fi
}

function o {
  if [ -z "$1" ]
  then
    open .
  else
    open $1
  fi
}



alias hosts='sudo code --new-window /etc/hosts'
alias sshconf='code --new-window ~/.ssh/config'
alias online="ping -c 1 www.example.com &> /dev/null && echo 'Online :)' || echo 'Offline :('"


# Single command: `code --install-extension alpha --install-extension beta ...``
alias vsextensions="code --force $(cat ~/.vscode/Extensionsfile | sed 's/^/--install-extension /')"

function diffx {
  `/Applications/Xcode.app/Contents/Applications/FileMerge.app/Contents/MacOS/FileMerge -left $1 -right $2`
}

function defs {
  defa; sleep 2; defb
}

function defa {
  defaults read > /tmp/defaults_a
}

function defb {
  defaults read > /tmp/defaults_b
  diff /tmp/defaults_a /tmp/defaults_b
}

function repeat {
  while sleep 2; do
    $@
  done
}


export EDITOR='code'
export HISTCONTROL=erasedups
export GOPATH=/Users/orange/.go
export TLDR_AUTO_UPDATE_DISABLED=1
